<Page
    x:Class="StremioXbox.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequiresPointer="Never"
    KeyDown="LibraryPage_KeyDown"
    Loaded="LibraryPage_Loaded">

    <Page.Resources>
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <ItemsStackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="PosterTemplate">
            <Grid Width="330" Height="510" Margin="0,0,22,0">
                <StackPanel>
                    <Grid Width="308" Height="458" HorizontalAlignment="Left">
                        <Border Width="300" Height="450" Margin="4"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#24213A" CornerRadius="8">
                            <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                        </Border>
                        <Border x:Name="PosterFocusRing" Width="308" Height="458"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0" CornerRadius="8"
                                IsHitTestVisible="False" />

                        <Grid Width="300" Height="6"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="4,0,0,8"
                              Visibility="{Binding ProgressVisibility}">
                            <Border Background="#664B456F" CornerRadius="3" />
                            <Border Width="{Binding ProgressWidth}"
                                    HorizontalAlignment="Left"
                                    Background="#C020FF"
                                    CornerRadius="3" />
                        </Grid>
                    </Grid>
                    <TextBlock Width="300" Margin="4,10,0,0" FontSize="18"
                               Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="PosterItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualPrimaryBrush" Value="Transparent" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
    </Page.Resources>

    <Grid Padding="12">
        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVerticalScrollChainingEnabled="False">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Visibility="{Binding RowVisibility}">
                            <TextBlock Text="{Binding Title}" FontSize="26"
                                       FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ListView ItemsSource="{Binding Items}"
                                      ItemsPanel="{StaticResource HorizontalPanel}"
                                      ItemTemplate="{StaticResource PosterTemplate}"
                                      ItemContainerStyle="{StaticResource PosterItemContainerStyle}"
                                      SelectionMode="None" IsItemClickEnabled="True"
                                      IsTabStop="True"
                                      Loaded="LibraryList_Loaded"
                                      KeyDown="LibraryList_KeyDown"
                                      ItemClick="Items_ItemClick"
                                      ContainerContentChanging="LibraryList_ContainerContentChanging"
                                      XYFocusKeyboardNavigation="Enabled"
                                      ScrollViewer.HorizontalScrollMode="Enabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ProgressRing x:Name="Loading" Width="64" Height="64"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsActive="True" />
        <TextBlock x:Name="Message" MaxWidth="700"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </Grid>
</Page>
