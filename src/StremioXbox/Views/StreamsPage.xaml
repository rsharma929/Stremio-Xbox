<Page
    x:Class="StremioXbox.Views.StreamsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">

        <Image
            x:Name="Backdrop"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Stretch="UniformToFill"
            Opacity="0.25"
            IsHitTestVisible="False" />

        <Rectangle
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Fill="Black"
            Opacity="0.25"
            IsHitTestVisible="False" />

        <Grid
            Padding="8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="Header"
                FontSize="32"
                FontWeight="Bold"
                TextTrimming="CharacterEllipsis" />

            <Grid
                Grid.Row="1"
                Margin="0,6,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="Status"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource MutedTextBrush}"
                    TextWrapping="Wrap" />

                <ComboBox
                    x:Name="SourceFilter"
                    Grid.Column="1"
                    Header="Source"
                    MinWidth="260"
                    HorizontalAlignment="Right"
                    IsTabStop="False"
                    SelectionChanged="SourceFilter_SelectionChanged"
                    DropDownClosed="SourceFilter_DropDownClosed"
                    KeyDown="SourceFilter_KeyDown" />
            </Grid>

            <TextBlock
                x:Name="StreamWarning"
                Grid.Row="2"
                Text="Streaming torrents requires a server URL. Set that up in Settings."
                Visibility="Collapsed"
                Foreground="Red"
                FontWeight="Bold"
                TextWrapping="Wrap"
                Margin="0,4,0,8" />

            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="12"
                Margin="0,0,0,8">
                <TextBlock
                    x:Name="EpisodeWatchStatus"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource AccentPurpleBrush}"
                    FontWeight="SemiBold"
                    Visibility="Collapsed" />

                <Button
                    x:Name="MarkWatchedButton"
                    Click="MarkWatchedButton_Click"
                    Visibility="Collapsed"
                    IsTabStop="True"
                    AutomationProperties.Name="Toggle watched state">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image
                            Source="ms-appx:///Assets/XButton.png"
                            Width="22"
                            Height="22"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Name="MarkWatchedButtonText"
                            VerticalAlignment="Center"
                            Text="Mark as watched" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListView
                x:Name="StreamList"
                Grid.Row="4"
                Width="1100"
                MaxWidth="1100"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                SelectionMode="None"
                IsItemClickEnabled="True"
                IsTabStop="False"
                ItemClick="StreamList_ItemClick">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="0,10"
                            ColumnSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="{Binding LockIcon}"
                                Visibility="{Binding LockVisibility}"
                                Grid.Column="0"
                                FontSize="18"
                                Foreground="Red"
                                VerticalAlignment="Top" />

                            <TextBlock
                                Text="{Binding Name}"
                                Grid.Column="1"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Foreground="{Binding NameBrush}" />

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Text="{Binding Label}"
                                    TextWrapping="Wrap"
                                    MaxLines="4"
                                    Foreground="{Binding TextBrush}" />

                                <TextBlock
                                    Text="{Binding AddonName}"
                                    FontSize="13"
                                    Foreground="{Binding MutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ProgressRing
            x:Name="Loading"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True"
            Width="64"
            Height="64" />
    </Grid>
</Page>
