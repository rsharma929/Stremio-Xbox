<Page
    x:Class="StremioXbox.Views.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.25" />

        <Grid Padding="8" ColumnSpacing="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border CornerRadius="8" Background="#2A2840" Height="390">
                    <Image x:Name="Poster" Stretch="UniformToFill" />
                </Border>
                <Button x:Name="PlayButton" Content="Watch" HorizontalAlignment="Stretch" Margin="0,16,0,0"
                        Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" Click="PlayButton_Click" />
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="Title" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock x:Name="Info" Grid.Row="1" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                <TextBlock x:Name="Description" Grid.Row="2" TextWrapping="Wrap" MaxLines="5" Margin="0,12,0,0" />

                <Grid x:Name="EpisodesPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox
                        x:Name="SeasonPicker"
                        Header="Season"
                        MinWidth="200"
                        SelectionChanged="SeasonPicker_SelectionChanged"
                        DropDownClosed="SeasonPicker_DropDownClosed"
                        KeyDown="SeasonPicker_KeyDown" />
                    <ListView x:Name="Episodes" Grid.Row="1" Margin="0,12,0,0" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="Episodes_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="18" />
                                        <TextBlock Text="{Binding Released}" FontSize="13"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding StatusText}"
                                                   Visibility="{Binding StatusVisibility}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontSize="13" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Tag="{Binding}"
                                            IsEnabled="{Binding CanMarkWatched}"
                                            Click="MarkWatched_Click"
                                            MinWidth="150"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Mark watched">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <Image
                                                Source="ms-appx:///Assets/XButton.png"
                                                Width="22"
                                                Height="22"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                Text="{Binding MarkWatchedText}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <ProgressRing x:Name="Loading" IsActive="True" Width="64" Height="64" />
    </Grid>
</Page>
