<Page
    x:Class="StremioXbox.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <Grid Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="Query" PlaceholderText="Search movies and series" FontSize="22" MaxWidth="800"
                 HorizontalAlignment="Left" Width="800" KeyDown="Query_KeyDown" InputScope="Search" />

        <GridView x:Name="Results" Grid.Row="1" Margin="0,16,0,0" SelectionMode="None" IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource PosterTemplate}" ItemClick="Results_ItemClick" />

        <ProgressRing x:Name="Loading" Grid.Row="1" IsActive="False" Width="64" Height="64" />
        <TextBlock x:Name="Message" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}" Text="Press A on the box above to type, then Menu/Enter to search." />
    </Grid>
</Page>
